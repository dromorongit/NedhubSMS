# Nedhub Backend Environment Variables

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/nedhub

# JWT Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Email Configuration
# Supported providers: 'resend' (default), 'brevo' (for Railway Hobby)
EMAIL_PROVIDER=brevo

# Resend API Configuration
# Get your API key from https://resend.com
SENDGRID_API_KEY=SG.your_api_key_here
RESEND_API_KEY=re_your_resend_key_here

# Brevo API Configuration (Railway Hobby compatible)
# Get your API key from https://app.brevo.com
BREVO_API_KEY=your_brevo_api_key_here

# Email sender configuration (used by all providers)
EMAIL_FROM=support@nedhubgh.com
EMAIL_FROM_NAME=Nedhub Support

# Admin notification email (internal notifications)
ADMIN_NOTIFICATION_EMAIL=info@nedhubgh.com

# Frontend URL (for email links)
FRONTEND_URL=https://app.nedhubgh.com
APP_BASE_URL=https://nedhubgh.com

# Redis Configuration for Job Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_USERNAME=

# Nalo SMS Configuration
# Get your API key from https://sms.nalosolutions.com
NALO_API_KEY=your_nalo_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development
