{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "NIXPACKS",
    "options": {
      "nodeJs": {
        "packageManager": "npm"
      }
    }
  },
  "deploy": {
    "startCommand": "node server/index.js",
    "rootDirectory": ".",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
