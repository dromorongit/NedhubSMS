# Environment variables for Nedhub Bulk Messaging Backend

# Server configuration
PORT=3000
NODE_ENV=development

# Database configuration (using MongoDB for Railway)
MONGODB_URI=mongodb://localhost:27017/nedhub_bulk_messaging

# JWT configuration
JWT_SECRET=your_very_secure_jwt_secret_here
JWT_EXPIRES_IN=24h

# Nalo SMS API configuration
NALO_API_KEY=your_nalo_api_key_here
NALO_API_URL=https://api.nalosolutions.com/v1/sms
NALO_SENDER_ID=NEDHUB
NALO_CALLBACK_URL=https://api.nedhubgh.com/api/sms/callback

# Rate limiting
RATE_LIMIT_WINDOW_MS=15 * 60 * 1000
RATE_LIMIT_MAX=100