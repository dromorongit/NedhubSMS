# Nedhub Backend Environment Variables

# ============================================
# MongoDB Connection
# ============================================
MONGODB_URI=mongodb://localhost:27017/YOUR_DATABASE_NAME_HERE

# ============================================
# JWT Authentication
# ============================================
# JWT Secret (generate a strong random string)
JWT_SECRET=YOUR_JWT_SECRET_HERE_AT_LEAST_32_CHARS

# ============================================
# Email Configuration
# ============================================
# Supported providers: 'resend' (default), 'brevo' (for Railway Hobby)
EMAIL_PROVIDER=brevo

# Resend API Configuration
# Get your API key from https://resend.com
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY_HERE
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE

# Brevo API Configuration (Railway Hobby compatible)
# Get your API key from https://app.brevo.com
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE

# Email sender configuration (used by all providers)
EMAIL_FROM=support@nedhubgh.com
EMAIL_FROM_NAME=Nedhub Support

# Admin notification email (internal notifications)
ADMIN_NOTIFICATION_EMAIL=info@nedhubgh.com

# ============================================
# Application URLs
# ============================================
# CRITICAL: APP_URL is used for Hubtel callback URLs.
# Must be the PUBLIC URL of your backend server (e.g. Railway URL).
# Without this, Hubtel callbacks will fail and airtime/data will never be confirmed.
APP_URL=https://nedhubsms-production.up.railway.app
FRONTEND_URL=https://app.nedhubgh.com
APP_BASE_URL=https://nedhubgh.com

# ============================================
# Hubtel Direct API (Airtime & Data)
# ============================================
# Get credentials from https://hubtel.com/developers
HUBTEL_CLIENT_ID=YOUR_HUBTEL_CLIENT_ID_HERE
HUBTEL_CLIENT_SECRET=YOUR_HUBTEL_CLIENT_SECRET_HERE
HUBTEL_MERCHANT_ACCOUNT_NUMBER=YOUR_HUBTEL_MERCHANT_ACCOUNT_NUMBER_HERE
HUBTEL_PREPAID_DEPOSIT_ID=YOUR_HUBTEL_PREPAID_DEPOSIT_ID_HERE
# Callback URL for Hubtel to notify us of transaction status
# Must be publicly accessible (no localhost, no ngrok)
HUBTEL_CALLBACK_URL=https://nedhubsms-production.up.railway.app/api/hubtel/airtime-callback
# Per-type callback URLs (override HUBTEL_CALLBACK_URL for each type)
HUBTEL_AIRTIME_CALLBACK_URL=https://nedhubsms-production.up.railway.app/api/hubtel/airtime-callback
HUBTEL_DATA_CALLBACK_URL=https://nedhubsms-production.up.railway.app/api/hubtel/data-callback
HUBTEL_MOMO_CALLBACK_URL=https://nedhubsms-production.up.railway.app/api/hubtel/momo-callback
HUBTEL_BANK_CALLBACK_URL=https://nedhubsms-production.up.railway.app/api/hubtel/bank-callback
# Optional: override individual endpoints (defaults shown)
HUBTEL_AIRTIME_ENDPOINT=https://smp.hubtel.com/api/merchants
HUBTEL_DATA_ENDPOINT=https://smp.hubtel.com/api/merchants
HUBTEL_MOMO_ENDPOINT=https://smp.hubtel.com/api/merchants
HUBTEL_BANK_ENDPOINT=https://smp.hubtel.com/api/merchants

# ============================================
# Hubtel amount mode (payment status checks)
# ============================================
# gross (default, current behaviour): providerAmount = statusData.amount ||
#   statusData.totalAmount
# net: providerAmount = statusData.netAmount || statusData.net_amount ||
#   statusData.amountAfterFee. In net mode there is NO gross fallback: if no
#   net field is present the amount is unknown (null), the payment stays
#   pending and one warning is logged.
# Switch to net only after inspecting a real Hubtel response with
# scripts/inspect-hubtel-status.js. See reference/callback-runbook.md.
HUBTEL_AMOUNT_MODE=gross

# ============================================
# Pending Confirmation Timeout Recovery
# ============================================
# Auto-fail transactions stuck in pending_confirmation after this many ms (default: 10 minutes)
PENDING_CONFIRMATION_TIMEOUT_MS=600000
# How often to scan for stale pending_confirmation transactions (default: 60 seconds)
PENDING_CONFIRMATION_SCAN_INTERVAL_MS=60000

# ============================================
# Redis Configuration for Job Queues
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_USERNAME=

# ============================================
# Nalo SMS Configuration
# ============================================
# Get your API key from https://sms.nalosolutions.com
NALO_API_KEY=YOUR_NALO_API_KEY_HERE

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# Airtime/Data Limits
# ============================================
MAX_AIRTIME_AMOUNT=500

