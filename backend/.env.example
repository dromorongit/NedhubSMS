# Nedhub Backend Environment Variables

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/nedhub

# JWT Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Email Configuration (Resend API - Railway Hobby compatible)
# Get your API key from https://resend.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=support@nedhubgh.com
EMAIL_FROM_NAME=Nedhub

# Frontend URL (for email links)
FRONTEND_URL=https://app.nedhubgh.com
APP_BASE_URL=https://nedhubgh.com

# Server Configuration
PORT=3000
NODE_ENV=development

# Legacy SMTP Configuration (no longer used - kept for reference)
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=support@nedhubgh.com
# SMTP_PASS=your_email_password_here
