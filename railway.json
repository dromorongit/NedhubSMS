{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "DOCKER",
    "options": {}
  },
  "deploy": {
    "startCommand": "node server/index.js",
    "rootDirectory": ".",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
